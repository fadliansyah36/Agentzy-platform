# Agentzy API — copy to .env and provide values through the deployment secret manager.
# Never commit real credentials. Blank values intentionally keep optional providers disabled.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://cwhjdnkotuhueeudpgeu.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_PROVIDER_WEBHOOK_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Public partnership anti-abuse. In production Turnstile verification fails closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private attachment scanning. Worker remains disabled until both are configured.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Transactional notification delivery. SMTP outbox persists while this adapter is disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Google Workspace OAuth — server-side only; configure official credentials at deployment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/oauth/callback
# Fernet key: URL-safe base64 encoding of 32 random bytes. Keep stable for token decryption.
OAUTH_TOKEN_ENCRYPTION_KEY=
